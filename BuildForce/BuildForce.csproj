<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0-android</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <RootNamespace>BuildForce</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NoWarn>XC0103;CS1998;CA1416;CS0618;NU1608</NoWarn>
        <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
        <ApplicationTitle>Mezano</ApplicationTitle>
        <ApplicationId>com.mezano.buildforce</ApplicationId>
        <ApplicationDisplayVersion>2.5.1</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <!-- NU1608: CommunityToolkit.Maui.Camera 5.0.0 pulls Fragment.Ktx 1.8.8.1 and
         Lifecycle.Process 2.9.2.1, which declare upper bounds the .NET 10 MAUI
         workload deliberately resolves past. Transitive, not our dependency graph.
         Pinning AndroidX down a version risks the camera at runtime, so accepted. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#080b10" />
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#080b10" BaseSize="128,128" />
        <MauiImage Include="Resources\Images\*" />
        <MauiFont Include="Resources\Fonts\*" />
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Maui" Version="14.2.0" />
        <PackageReference Include="CommunityToolkit.Maui.Camera" Version="5.0.0" />
        <PackageReference Include="SkiaSharp" Version="3.116.1" />
        <PackageReference Include="SkiaSharp.NativeAssets.Android" Version="3.116.1" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.60" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.8" />
    </ItemGroup>
    <ItemGroup>
        <Compile Update="Views\TimesheetDetailPage.xaml.cs">
            <DependentUpon>TimesheetDetailPage.xaml</DependentUpon>
        </Compile>
        <Compile Update="Views\SafetyCheckPage.xaml.cs">
            <DependentUpon>SafetyCheckPage.xaml</DependentUpon>
        </Compile>
        <Compile Update="Views\InjuryReportPage.xaml.cs">
            <DependentUpon>InjuryReportPage.xaml</DependentUpon>
        </Compile>
        <Compile Update="Views\ProjectCreatePage.xaml.cs">
            <DependentUpon>ProjectCreatePage.xaml</DependentUpon>
        </Compile>
        <Compile Update="Views\ExpenseCreatePage.xaml.cs">
            <DependentUpon>ExpenseCreatePage.xaml</DependentUpon>
        </Compile>
        <Compile Update="Views\PunchCameraPage.xaml.cs">
            <DependentUpon>PunchCameraPage.xaml</DependentUpon>
        </Compile>
    </ItemGroup>
    <ItemGroup>
        <MauiXaml Update="App.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="AppShell.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\LoginPage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\MainShellPage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\DashboardPage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\TimeClockPage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\InvoicesPage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\ProjectsPage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\TimesheetDetailPage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\SafetyCheckPage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\InjuryReportPage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\ProjectCreatePage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\ExpenseCreatePage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\PunchCameraPage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
    </ItemGroup>
</Project>


