<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BuildForce.Views.PickerSheetPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#CC000000">

    <Grid RowDefinitions="*,Auto">

        <Grid Grid.Row="0" BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnScrimTapped" />
            </Grid.GestureRecognizers>
        </Grid>

        <Border Grid.Row="1" BackgroundColor="#0d1117"
                Stroke="#1c2330" StrokeThickness="1"
                StrokeShape="RoundRectangle 22,22,0,0"
                Padding="0,0,0,10">
            <VerticalStackLayout Spacing="0">

                <BoxView Color="#2c3444" WidthRequest="42" HeightRequest="4"
                         CornerRadius="2" Margin="0,10,0,0"
                         HorizontalOptions="Center" />

                <Grid ColumnDefinitions="Auto,*,Auto" Padding="18,14,14,10">
                    <BoxView Color="#f0a500" WidthRequest="3" HeightRequest="20"
                             CornerRadius="2" VerticalOptions="Center" />
                    <Label x:Name="TitleLabel" Grid.Column="1" Margin="10,0,0,0"
                           Text="Select" FontSize="15" FontAttributes="Bold"
                           TextColor="#e6edf3" VerticalOptions="Center" />
                    <Button Grid.Column="2" Text="Cancel" Clicked="OnCancel"
                            BackgroundColor="Transparent" TextColor="#7d8590"
                            FontSize="12" HeightRequest="34" Padding="10,0" />
                </Grid>

                <Border x:Name="SearchWrap" IsVisible="False"
                        BackgroundColor="#161b22" Stroke="#1c2330" StrokeThickness="1"
                        StrokeShape="RoundRectangle 10" Margin="16,0,16,10" Padding="12,0">
                    <Entry x:Name="SearchEntry" Placeholder="Type to filter..."
                           PlaceholderColor="#7d8590" TextColor="#e6edf3"
                           BackgroundColor="Transparent" TextChanged="OnSearchChanged" />
                </Border>

                <ScrollView x:Name="Scroller" MaximumHeightRequest="420">
                    <VerticalStackLayout x:Name="OptionList" Padding="12,0,12,8" Spacing="6" />
                </ScrollView>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>