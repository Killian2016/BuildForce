<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:BuildForce.Views"
             x:Class="BuildForce.Views.MainShellPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#080b10">

    <Grid RowDefinitions="*, Auto">

        <ContentView x:Name="PageContent" Grid.Row="0" />

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" BackgroundColor="Transparent">
            <BoxView Grid.Row="0" HeightRequest="1" BackgroundColor="#1c2330" />
            <Grid Grid.Row="1" BackgroundColor="#0d1117" Padding="0,8,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <VerticalStackLayout x:Name="TabHome" Grid.Column="0" Spacing="3"
                                     HorizontalOptions="Fill" VerticalOptions="Center"
                                     Padding="0,4">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="NavHome_Tapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label x:Name="IcoHome" Text="&#x2302;" FontSize="24"
                           TextColor="#f0a500" HorizontalOptions="Center" InputTransparent="True" />
                    <Label x:Name="LblHome" Text="Home" FontSize="9" FontAttributes="Bold"
                           TextColor="#f0a500" HorizontalOptions="Center" CharacterSpacing="0.5"
                           InputTransparent="True" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="TabProjects" Grid.Column="1" Spacing="3"
                                     HorizontalOptions="Fill" VerticalOptions="Center"
                                     Padding="0,4">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="NavProjects_Tapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label x:Name="IcoProjects" Text="&#x25A6;" FontSize="22"
                           TextColor="#7d8590" HorizontalOptions="Center" InputTransparent="True" />
                    <Label x:Name="LblProjects" Text="Projects" FontSize="9" FontAttributes="Bold"
                           TextColor="#7d8590" HorizontalOptions="Center" CharacterSpacing="0.5"
                           InputTransparent="True" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="3"
                                     HorizontalOptions="Center" VerticalOptions="Center">
                    <Border x:Name="ClockBtn"
                            BackgroundColor="#f0a500"
                            StrokeShape="RoundRectangle 26"
                            WidthRequest="52" HeightRequest="52"
                            Stroke="Transparent"
                            HorizontalOptions="Center">
                        <Border.Shadow>
                            <Shadow Brush="#f0a500" Offset="0,4" Radius="12" Opacity="0.4" />
                        </Border.Shadow>
                        <Label x:Name="ClockLabel"
                               Text="GPS" FontSize="12" FontAttributes="Bold"
                               TextColor="#1a1a1a"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               InputTransparent="True" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="NavClock_Tapped" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Label x:Name="LblClock" Text="Clock" FontSize="9" FontAttributes="Bold"
                           TextColor="#f0a500" HorizontalOptions="Center" CharacterSpacing="0.5" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="TabSchedule" Grid.Column="3" Spacing="3"
                                     HorizontalOptions="Fill" VerticalOptions="Center"
                                     Padding="0,4">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="NavSchedule_Tapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label x:Name="IcoSchedule" Text="&#x25A4;" FontSize="22"
                           TextColor="#7d8590" HorizontalOptions="Center" InputTransparent="True" />
                    <Label x:Name="LblSchedule" Text="Schedule" FontSize="9" FontAttributes="Bold"
                           TextColor="#7d8590" HorizontalOptions="Center" CharacterSpacing="0.5"
                           InputTransparent="True" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="TabTools" Grid.Column="4" Spacing="3"
                                     HorizontalOptions="Fill" VerticalOptions="Center"
                                     Padding="0,4">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="NavTools_Tapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label x:Name="IcoTools" Text="&#x2699;" FontSize="22"
                           TextColor="#7d8590" HorizontalOptions="Center" InputTransparent="True" />
                    <Label x:Name="LblTools" Text="Tools" FontSize="9" FontAttributes="Bold"
                           TextColor="#7d8590" HorizontalOptions="Center" CharacterSpacing="0.5"
                           InputTransparent="True" />
                </VerticalStackLayout>

            </Grid>
        </Grid>
    </Grid>
</ContentPage>
