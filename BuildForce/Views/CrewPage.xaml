<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BuildForce.Views.CrewPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#080b10">

    <Grid RowDefinitions="4,Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="*,*,*">
            <BoxView Color="#f0a500" />
            <BoxView Color="#0ea5e9" Grid.Column="1" />
            <BoxView Color="#10b981" Grid.Column="2" />
        </Grid>

        <Grid Grid.Row="1" Padding="16,14,16,10" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Text="CREW MONITOR" FontSize="10" FontAttributes="Bold"
                       TextColor="#7d8590" CharacterSpacing="2" />
                <Label x:Name="HeaderLabel" Text="On the clock" FontSize="20"
                       FontAttributes="Bold" TextColor="#e6edf3" />
                <Label x:Name="SubLabel" Text="Loading..." FontSize="12" TextColor="#7d8590" />
            </VerticalStackLayout>
            <Button Text="Close" BackgroundColor="Transparent" TextColor="#7d8590"
                    BorderColor="#1c2330" BorderWidth="1" FontSize="12"
                    HeightRequest="36" CornerRadius="10" Padding="14,0"
                    Grid.Column="1" VerticalOptions="Start"
                    Clicked="OnClose" />
        </Grid>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,4,16,28" Spacing="10">
                <ActivityIndicator x:Name="Loading" IsRunning="True" IsVisible="True"
                                   Color="#f0a500" Margin="0,8" />
                <Label x:Name="EmptyLabel" Text="" FontSize="13" TextColor="#7d8590"
                       IsVisible="False" HorizontalOptions="Center" Margin="0,20,0,0" />
                <Button x:Name="RetryBtn" Text="Refresh"
                        BackgroundColor="#f0a500" TextColor="#080b10"
                        FontSize="13" FontAttributes="Bold" HeightRequest="44"
                        CornerRadius="12" IsVisible="False"
                        Clicked="OnRefresh" />
                <VerticalStackLayout x:Name="CrewList" Spacing="8" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
