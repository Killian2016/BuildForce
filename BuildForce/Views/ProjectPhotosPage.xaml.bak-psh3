<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BuildForce.Views.ProjectPhotosPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#080b10">

    <Grid RowDefinitions="4,Auto,*">

        <!-- accent bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*">
            <BoxView Color="#f0a500" />
            <BoxView Color="#0ea5e9" Grid.Column="1" />
            <BoxView Color="#10b981" Grid.Column="2" />
        </Grid>

        <!-- header + controls -->
        <VerticalStackLayout Grid.Row="1" Padding="16,14,16,8" Spacing="12">

            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="SITE PHOTOS [PP2]" FontSize="10" FontAttributes="Bold"
                           TextColor="#7d8590" CharacterSpacing="2" />
                    <Label x:Name="HeaderLabel" Text="Project photos" FontSize="20"
                           FontAttributes="Bold" TextColor="#e6edf3" />
                    <Label x:Name="SubLabel" Text="Loading..." FontSize="12" TextColor="#7d8590" />
                </VerticalStackLayout>
                <Button Text="Close" BackgroundColor="Transparent" TextColor="#7d8590"
                        BorderColor="#1c2330" BorderWidth="1" FontSize="12"
                        HeightRequest="36" CornerRadius="10" Padding="14,0"
                        Grid.Column="1" VerticalOptions="Start"
                        Clicked="OnClose" />
            </Grid>

            <!-- project picker -->
            <Border BackgroundColor="#0d1117" Stroke="#1c2330" StrokeThickness="1"
                    StrokeShape="RoundRectangle 12" Padding="12,4">
                <Grid ColumnDefinitions="Auto,*">
                    <BoxView Color="#0ea5e9" WidthRequest="3" HeightRequest="26"
                             CornerRadius="2" VerticalOptions="Center" />
                    <Picker x:Name="ProjectPicker" Grid.Column="1" Margin="10,0,0,0"
                            Title="Select project" TitleColor="#7d8590"
                            TextColor="#e6edf3" BackgroundColor="Transparent"
                            SelectedIndexChanged="OnProjectChanged" />
                </Grid>
            </Border>

            <!-- take photo -->
            <Button x:Name="CaptureBtn" Text="Take photo"
                    BackgroundColor="#f0a500" TextColor="#080b10"
                    FontSize="15" FontAttributes="Bold" HeightRequest="50"
                    CornerRadius="12" Clicked="OnCapture" />

            <Label x:Name="StatusLabel" Text="" FontSize="12" TextColor="#f0a500"
                   IsVisible="False" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- gallery -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,4,16,28" Spacing="12">
                <ActivityIndicator x:Name="Loading" IsRunning="False" IsVisible="False"
                                   Color="#f0a500" Margin="0,8" />
                <Label x:Name="EmptyLabel" Text="" FontSize="13" TextColor="#7d8590"
                       IsVisible="False" HorizontalOptions="Center" Margin="0,20,0,0" />
                <VerticalStackLayout x:Name="PhotoList" Spacing="12" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- full-screen photo viewer: pinch to zoom, drag to pan, double-tap to reset -->
        <Grid x:Name="ViewerOverlay" Grid.Row="0" Grid.RowSpan="3"
              BackgroundColor="#F5050709" IsVisible="False">
            <Grid.GestureRecognizers>
                <PinchGestureRecognizer PinchUpdated="OnViewerPinch" />
                <PanGestureRecognizer PanUpdated="OnViewerPan" />
                <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnViewerDoubleTap" />
            </Grid.GestureRecognizers>

            <Image x:Name="ViewerImage" Aspect="AspectFit"
                   HorizontalOptions="Fill" VerticalOptions="Fill"
                   Margin="0,60,0,64" InputTransparent="True" />

            <Grid VerticalOptions="Start" Padding="16,12" ColumnDefinitions="Auto,*,Auto">
                <Button Text="Close" BackgroundColor="Transparent" TextColor="#e6edf3"
                        BorderColor="#1c2330" BorderWidth="1" FontSize="12"
                        HeightRequest="36" CornerRadius="10" Padding="14,0"
                        Clicked="OnViewerClose" />
                <Button x:Name="ViewerDeleteBtn" Grid.Column="2" Text="Delete"
                        BackgroundColor="Transparent" TextColor="#ef4444"
                        BorderColor="#ef4444" BorderWidth="1" FontSize="12"
                        HeightRequest="36" CornerRadius="10" Padding="14,0"
                        Clicked="OnViewerDelete" />
            </Grid>

            <Label x:Name="ViewerCaption" VerticalOptions="End" Margin="16,0,16,18"
                   FontSize="12" TextColor="#e6edf3" HorizontalTextAlignment="Center" />
        </Grid>
    </Grid>
</ContentPage>
