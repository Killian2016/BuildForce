<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BuildForce.Views.NotificationsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#080b10">

    <Grid RowDefinitions="4,Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="*,*,*">
            <BoxView Color="#8b5cf6" />
            <BoxView Color="#0ea5e9" Grid.Column="1" />
            <BoxView Color="#f0a500" Grid.Column="2" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Padding="16,14,16,8" Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="ALERTS [NOT3]" FontSize="10" FontAttributes="Bold"
                           TextColor="#7d8590" CharacterSpacing="2" />
                    <Label Text="Notifications" FontSize="20"
                           FontAttributes="Bold" TextColor="#e6edf3" />
                    <Label x:Name="SubLabel" Text="Loading..." FontSize="12" TextColor="#7d8590" />
                </VerticalStackLayout>
                <Button Text="Close" BackgroundColor="Transparent" TextColor="#7d8590"
                        BorderColor="#1c2330" BorderWidth="1" FontSize="12"
                        HeightRequest="36" CornerRadius="10" Padding="14,0"
                        Grid.Column="1" VerticalOptions="Start"
                        Clicked="OnClose" />
            </Grid>

            <Button x:Name="MarkAllBtn" Text="Mark all read" IsVisible="False"
                    BackgroundColor="Transparent" TextColor="#8b5cf6"
                    BorderColor="#8b5cf6" BorderWidth="1"
                    FontSize="12" HeightRequest="38" CornerRadius="12"
                    Clicked="OnMarkAll" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,4,16,28" Spacing="10">
                <ActivityIndicator x:Name="Loading" IsRunning="False" IsVisible="False"
                                   Color="#8b5cf6" Margin="0,8" />
                <Label x:Name="EmptyLabel" Text="" FontSize="13" TextColor="#7d8590"
                       IsVisible="False" HorizontalOptions="Center" Margin="0,20,0,0"
                       HorizontalTextAlignment="Center" />
                <VerticalStackLayout x:Name="NotifList" Spacing="10" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>