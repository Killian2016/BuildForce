<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BuildForce.Views.TimeClockPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#080b10">

    <Grid RowDefinitions="4,*">

        <Grid Grid.Row="0" ColumnDefinitions="*,*,*">
            <BoxView Color="#f0a500" />
            <BoxView Color="#0ea5e9" Grid.Column="1" />
            <BoxView Color="#10b981" Grid.Column="2" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,16,16,100" Spacing="14">

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="FIELD &#x203A; TIME CLOCK [M6]"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#7d8590" CharacterSpacing="2"
                           VerticalOptions="Center" />
                    <Border x:Name="ClockedInBadge"
                            BackgroundColor="#0f2a22"
                            Stroke="#10b981" StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="10,4"
                            Grid.Column="1"
                            IsVisible="False">
                        <Label Text="LIVE" FontSize="10"
                               FontAttributes="Bold" TextColor="#10b981" />
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="2">
                    <Label Text="Time Clock"
                           FontSize="22" FontAttributes="Bold"
                           TextColor="#e6edf3" />
                    <Label Text="Mezano CM &#183; BuildForce"
                           FontSize="11" TextColor="#7d8590" />
                </VerticalStackLayout>

                <Border BackgroundColor="#0d1117"
                        Stroke="#1c2330" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,12">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border BackgroundColor="#2a2210"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 22"
                                WidthRequest="44" HeightRequest="44">
                            <Label x:Name="AvatarLabel" Text="--"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="#f0a500"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0"
                                             Spacing="2" VerticalOptions="Center">
                            <Label x:Name="EmployeeNameLabel"
                                   Text="Loading..."
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="#e6edf3" />
                            <Label x:Name="NowDateLabel"
                                   Text=""
                                   FontSize="11" TextColor="#7d8590" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border BackgroundColor="#0d1117"
                        Stroke="#1c2330" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,4">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="PROJECT"
                               FontSize="9" FontAttributes="Bold"
                               TextColor="#7d8590" CharacterSpacing="2"
                               Margin="0,8,0,0" />
                        <Picker x:Name="ProjectPicker"
                                Title="Select Project"
                                TextColor="#e6edf3"
                                TitleColor="#7d8590"
                                BackgroundColor="Transparent" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="#0d1117"
                        Stroke="#1c2330" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,4">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="COST CODE"
                               FontSize="9" FontAttributes="Bold"
                               TextColor="#7d8590" CharacterSpacing="2"
                               Margin="0,8,0,0" />
                        <Picker x:Name="CostCodePicker"
                                Title="Select..."
                                TextColor="#e6edf3"
                                TitleColor="#7d8590"
                                BackgroundColor="Transparent" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="#0d1117"
                        Stroke="#1c2330" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="SITE GEOFENCE"
                               FontSize="9" FontAttributes="Bold"
                               TextColor="#7d8590" CharacterSpacing="2" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border x:Name="GeoIconBox"
                                    BackgroundColor="#2a2210"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="40" HeightRequest="40">
                                <Label x:Name="GeoIconLabel" Text="&#x25CE;"
                                       FontSize="18" TextColor="#f0a500"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2"
                                                 VerticalOptions="Center">
                                <Label x:Name="GeofenceLabel"
                                       Text="Waiting for GPS..."
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="#f0a500" />
                                <Label x:Name="LocationLabel"
                                       Text="Getting location..."
                                       FontSize="11" TextColor="#7d8590" />
                            </VerticalStackLayout>
                        </Grid>
                        <Button x:Name="RetryLocationBtn"
                                Text="Retry Location Check"
                                BackgroundColor="#161b22"
                                TextColor="#e6edf3"
                                FontSize="12"
                                HeightRequest="38"
                                CornerRadius="10"
                                IsVisible="False"
                                Clicked="OnRetryLocation" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="#0d1117"
                        Stroke="#1c2330" StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="18,22">
                    <VerticalStackLayout Spacing="14">

                        <Label x:Name="StatusLabel"
                               Text="NOT CLOCKED IN"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="#7d8590"
                               CharacterSpacing="1"
                               HorizontalOptions="Center" />

                        <Grid WidthRequest="230" HeightRequest="230"
                              HorizontalOptions="Center">
                            <GraphicsView x:Name="RingView"
                                          WidthRequest="230" HeightRequest="230" />
                            <VerticalStackLayout HorizontalOptions="Center"
                                                 VerticalOptions="Center"
                                                 Spacing="3">
                                <Label x:Name="TimerLabel"
                                       Text="00:00:00"
                                       FontSize="34" FontAttributes="Bold"
                                       TextColor="#f0a500"
                                       HorizontalOptions="Center" />
                                <Label Text="ON SHIFT"
                                       FontSize="9" FontAttributes="Bold"
                                       TextColor="#7d8590" CharacterSpacing="2"
                                       HorizontalOptions="Center" />
                                <Border x:Name="StatusChip"
                                        BackgroundColor="#161b22"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 20"
                                        Padding="12,4"
                                        HorizontalOptions="Center"
                                        Margin="0,6,0,0">
                                    <Label x:Name="StatusChipLabel"
                                           Text="CLOCKED OUT"
                                           FontSize="10" FontAttributes="Bold"
                                           TextColor="#7d8590"
                                           CharacterSpacing="1" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Button x:Name="ClockInBtn"
                                Text="Clock In"
                                BackgroundColor="#1c2330"
                                TextColor="#7d8590"
                                FontSize="15" FontAttributes="Bold"
                                HeightRequest="54"
                                CornerRadius="14"
                                IsEnabled="False"
                                Clicked="OnClockIn" />
                        <Label x:Name="ClockInHint"
                               Text="Selfie + safety check next"
                               FontSize="11" TextColor="#7d8590"
                               HorizontalOptions="Center"
                               Margin="0,-6,0,0" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button x:Name="BreakBtn"
                                    Text="Break"
                                    BackgroundColor="#0d1117"
                                    TextColor="#e6edf3"
                                    BorderColor="#1c2330"
                                    BorderWidth="1"
                                    FontSize="13" FontAttributes="Bold"
                                    HeightRequest="48"
                                    CornerRadius="12"
                                    IsEnabled="False"
                                    Clicked="OnBreak" />
                            <Button x:Name="SwitchJobBtn"
                                    Text="Switch Job"
                                    BackgroundColor="#0d1117"
                                    TextColor="#8b5cf6"
                                    BorderColor="#1c2330"
                                    BorderWidth="1"
                                    FontSize="13" FontAttributes="Bold"
                                    HeightRequest="48"
                                    CornerRadius="12"
                                    Grid.Column="1"
                                    Clicked="OnSwitchJob" />
                        </Grid>

                        <Border x:Name="SiteWatchCard"
                                BackgroundColor="#0d1117"
                                Stroke="#10b981" StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="12,10"
                                IsVisible="False">
                            <Label x:Name="SiteWatchLabel"
                                   Text="Site watch on &#183; you will be alerted if you leave the site"
                                   FontSize="11" TextColor="#7d8590" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSiteWatchCardTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Button x:Name="ClockOutBtn"
                                Text="Clock Out"
                                BackgroundColor="Transparent"
                                TextColor="#ef4444"
                                BorderColor="#ef4444"
                                BorderWidth="1.5"
                                FontSize="14" FontAttributes="Bold"
                                HeightRequest="52"
                                CornerRadius="14"
                                IsEnabled="False"
                                Clicked="OnClockOut" />

                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="#0d1117"
                        Stroke="#1c2330" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="16,14">
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="4">
                        <Label Text="TODAY"
                               FontSize="9" FontAttributes="Bold"
                               TextColor="#7d8590" CharacterSpacing="1" />
                        <Label Text="THIS WEEK" Grid.Column="1"
                               FontSize="9" FontAttributes="Bold"
                               TextColor="#7d8590" CharacterSpacing="1" />
                        <Label Text="BREAK" Grid.Column="2"
                               FontSize="9" FontAttributes="Bold"
                               TextColor="#7d8590" CharacterSpacing="1" />
                        <Label x:Name="TodayHoursLabel"
                               Text="0.0h" Grid.Row="1"
                               FontSize="20" FontAttributes="Bold"
                               TextColor="#10b981" />
                        <Label x:Name="WeekHoursLabel"
                               Text="0.0h" Grid.Row="1" Grid.Column="1"
                               FontSize="20" FontAttributes="Bold"
                               TextColor="#0ea5e9" />
                        <Label x:Name="BreakTotalLabel"
                               Text="0m" Grid.Row="1" Grid.Column="2"
                               FontSize="20" FontAttributes="Bold"
                               TextColor="#f0a500" />
                        <Label x:Name="ActiveCostCodeLabel"
                               Text="Cost code: none" Grid.Row="2" Grid.ColumnSpan="3"
                               FontSize="11" TextColor="#7d8590"
                               Margin="0,4,0,0" />
                    </Grid>
                </Border>

                <Border BackgroundColor="#0d1117"
                        Stroke="#1c2330" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="16,14">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="THIS WEEK BY DAY"
                               FontSize="9" FontAttributes="Bold"
                               TextColor="#7d8590" CharacterSpacing="2" />
                        <Grid x:Name="WeekBarsGrid" HeightRequest="100"
                              ColumnSpacing="8" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="RECENT ENTRIES"
                       FontSize="10" FontAttributes="Bold"
                       TextColor="#7d8590" CharacterSpacing="2"
                       Margin="4,6,0,0" />

                <VerticalStackLayout x:Name="HistoryList" Spacing="8" />

            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="SwitchSheet" Grid.Row="1" IsVisible="False"
              BackgroundColor="#CC000000">
            <Border BackgroundColor="#0d1117" Stroke="#8b5cf6" StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Margin="20" Padding="18,16"
                    VerticalOptions="Center">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Leave for another job"
                           FontSize="16" FontAttributes="Bold" TextColor="#8b5cf6" />
                    <Label Text="Pick where you're heading. Your current job clocks out now and travel time starts counting until you arrive."
                           FontSize="12" TextColor="#7d8590" />
                    <ScrollView MaximumHeightRequest="280">
                        <VerticalStackLayout x:Name="SwitchProjectList" Spacing="8" />
                    </ScrollView>
                    <Button Text="Cancel"
                            BackgroundColor="Transparent" TextColor="#7d8590"
                            BorderColor="#1c2330" BorderWidth="1"
                            FontSize="12" HeightRequest="40" CornerRadius="12"
                            Clicked="OnSwitchCancel" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid x:Name="TravelSheet" Grid.Row="1" IsVisible="False"
              BackgroundColor="#CC000000">
            <Border BackgroundColor="#0d1117" Stroke="#8b5cf6" StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Margin="20" Padding="18,18"
                    VerticalOptions="Center">
                <VerticalStackLayout Spacing="14">
                    <Label Text="TRAVELING TO NEXT JOB"
                           FontSize="11" FontAttributes="Bold" TextColor="#8b5cf6"
                           CharacterSpacing="2" HorizontalOptions="Center" />
                    <Label x:Name="TravelToLabel" Text=""
                           FontSize="15" FontAttributes="Bold" TextColor="#e6edf3"
                           HorizontalOptions="Center" />
                    <Label x:Name="TravelTimerLabel" Text="00:00"
                           FontSize="40" FontAttributes="Bold" TextColor="#8b5cf6"
                           HorizontalOptions="Center" />
                    <Label Text="You're still on the clock. Tap Arrive when you reach the new site."
                           FontSize="12" TextColor="#7d8590" HorizontalTextAlignment="Center" />
                    <Label x:Name="TravelMsgLabel" Text="" IsVisible="False"
                           FontSize="12" FontAttributes="Bold" TextColor="#ef4444"
                           HorizontalTextAlignment="Center" />
                    <Button x:Name="ArriveBtn" Text="Arrive &amp; clock in"
                            BackgroundColor="#8b5cf6" TextColor="#080b10"
                            FontAttributes="Bold" FontSize="15"
                            HeightRequest="50" CornerRadius="12"
                            Clicked="OnArrive" />
                    <Button Text="Cancel - back to previous job"
                            BackgroundColor="Transparent" TextColor="#7d8590"
                            BorderColor="#1c2330" BorderWidth="1"
                            FontSize="12" HeightRequest="42" CornerRadius="12"
                            Clicked="OnCancelTravel" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid x:Name="ExitSheet" Grid.Row="1" IsVisible="False"
              BackgroundColor="#CC000000">
            <Border BackgroundColor="#0d1117" Stroke="#ef4444" StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Margin="20" Padding="18,16"
                    VerticalOptions="End">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Outside the geofence"
                           FontSize="16" FontAttributes="Bold" TextColor="#ef4444" />
                    <Label x:Name="ExitMsgLabel" Text=""
                           FontSize="12" TextColor="#7d8590" />
                    <Button Text="Clock out now"
                            BackgroundColor="#f0a500" TextColor="#080b10"
                            FontAttributes="Bold" FontSize="13"
                            HeightRequest="46" CornerRadius="12"
                            Clicked="OnExitClockOut" />
                    <Button Text="Material run - stay clocked in"
                            BackgroundColor="Transparent" TextColor="#e6edf3"
                            BorderColor="#1c2330" BorderWidth="1"
                            FontSize="13" HeightRequest="44" CornerRadius="12"
                            Clicked="OnExitMaterialRun" />
                    <Button Text="Snooze 10 min"
                            BackgroundColor="Transparent" TextColor="#7d8590"
                            BorderColor="#1c2330" BorderWidth="1"
                            FontSize="12" HeightRequest="40" CornerRadius="12"
                            Clicked="OnExitSnooze" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
