<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BuildForce.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0a1628">

    <ScrollView>
        <VerticalStackLayout Padding="28,60,28,40" Spacing="0">

            <!-- Logo -->
            <HorizontalStackLayout Spacing="12" Margin="0,0,0,48">
                <Image Source="mezano_round.png" WidthRequest="44" HeightRequest="44" Aspect="AspectFit" VerticalOptions="Center" />
                <Label Text="Mezano"
                       FontSize="24" FontAttributes="Bold"
                       TextColor="White" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Heading -->
            <Label Text="Sign in to"
                   FontSize="34" FontAttributes="Bold"
                   TextColor="White" LineHeight="1.1" />
            <Label Text="your workspace"
                   FontSize="34" FontAttributes="Bold"
                   TextColor="#c8e63c" Margin="0,0,0,8" />
            <Label Text="Enter your credentials to access your dashboard"
                   FontSize="14" TextColor="#6b7280"
                   Margin="0,0,0,40" />

            <!-- Email -->
            <Label Text="EMAIL ADDRESS"
                   FontSize="11" FontAttributes="Bold"
                   TextColor="#6b7280" CharacterSpacing="1.5"
                   Margin="0,0,0,8" />
            <Border BackgroundColor="#111f38"
                    Stroke="#1e3a5f" StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Margin="0,0,0,20">
                <Entry x:Name="EmailEntry"
                       Placeholder="you@company.com"
                       PlaceholderColor="#6b7280"
                       TextColor="White"
                       BackgroundColor="Transparent"
                       Keyboard="Email"
                       Margin="16,12" />
            </Border>

            <!-- Password -->
            <Label Text="PASSWORD"
                   FontSize="11" FontAttributes="Bold"
                   TextColor="#6b7280" CharacterSpacing="1.5"
                   Margin="0,0,0,8" />
            <Border BackgroundColor="#111f38"
                    Stroke="#1e3a5f" StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry x:Name="PasswordEntry"
                           Placeholder="Enter your password"
                           PlaceholderColor="#6b7280"
                           TextColor="White"
                           BackgroundColor="Transparent"
                           IsPassword="True"
                           Margin="16,12,0,12"
                           Grid.Column="0" />
                    <Border Grid.Column="1"
                            BackgroundColor="#1b3157"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,6"
                            Margin="0,0,10,0"
                            VerticalOptions="Center">
                        <Label x:Name="ToggleEye"
                               Text="SHOW"
                               FontSize="10"
                               FontAttributes="Bold"
                               CharacterSpacing="1"
                               TextColor="#9fb0c4"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTogglePassword" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
            </Border>

            <!-- [BFRM1] Remember me + Forgot password -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,28">
                <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                    <Border x:Name="RememberBox" WidthRequest="20" HeightRequest="20" BackgroundColor="#c8e63c" Stroke="#c8e63c" StrokeThickness="1" StrokeShape="RoundRectangle 5" VerticalOptions="Center">
                        <Label x:Name="RememberTick" Text="&#10003;" FontSize="13" FontAttributes="Bold" TextColor="#0a1628" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="Remember me" FontSize="13" TextColor="#9fb0c4" VerticalOptions="Center" />
                    <HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnRememberTapped" /></HorizontalStackLayout.GestureRecognizers>
                </HorizontalStackLayout>
                <Label Text="Forgot password?" FontSize="13" TextColor="#c8e63c" FontAttributes="Bold" Grid.Column="1" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnForgotPassword" />
                </Label.GestureRecognizers>
            </Label>
            </Grid>

            <!-- Error Label -->
            <Label x:Name="ErrorLabel"
                   TextColor="#ef4444"
                   FontSize="13"
                   IsVisible="False"
                   HorizontalOptions="Center"
                   Margin="0,0,0,16" />

            <!-- Sign In Button -->
            <Border BackgroundColor="#c8e63c"
                    StrokeShape="RoundRectangle 16"
                    Stroke="Transparent">
                <Button Text="Sign In →"
                        BackgroundColor="Transparent"
                        TextColor="#000000"
                        FontSize="16" FontAttributes="Bold"
                        Clicked="OnLoginClicked"
                        HeightRequest="56" />
            </Border>

            <!-- Loading -->
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#c8e63c"
                               Margin="0,16,0,0" />

            <!-- [GSIM1] divider + Continue with Google -->
            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Margin="0,22,0,14" IsVisible="{OnPlatform iOS=false, Default=true}">
                <BoxView Grid.Column="0" HeightRequest="1" Color="#1e3a5f" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="or" FontSize="12" TextColor="#6b7280" VerticalOptions="Center" />
                <BoxView Grid.Column="2" HeightRequest="1" Color="#1e3a5f" VerticalOptions="Center" />
            </Grid>
            <Border BackgroundColor="#111f38" Stroke="#1e3a5f" StrokeThickness="1" StrokeShape="RoundRectangle 16" IsVisible="{OnPlatform iOS=false, Default=true}">
                <Grid ColumnDefinitions="Auto,*" Padding="18,0" HeightRequest="54" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="G" FontSize="20" FontAttributes="Bold" TextColor="#4285F4" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Continue with Google" FontSize="15" FontAttributes="Bold" TextColor="White"
                           VerticalOptions="Center" HorizontalOptions="Center" />
                </Grid>
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnGoogleTapped" /></Border.GestureRecognizers>
            </Border>

            <!-- Register -->
            <HorizontalStackLayout HorizontalOptions="Center" Margin="0,24,0,0" Spacing="4" IsVisible="{OnPlatform iOS=false, Default=true}">
                <Label Text="Don't have an account?"
                       FontSize="13" TextColor="#6b7280" />
                <Label Text="Start free trial"
                       FontSize="13" TextColor="#c8e63c" FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRegisterTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>


            <!-- [BFLGN1] legal footer -->
            <HorizontalStackLayout HorizontalOptions="Center" Margin="0,40,0,0" Spacing="10">
                <Label Text="Privacy Policy" FontSize="12" TextColor="#6b7280"><Label.GestureRecognizers><TapGestureRecognizer Tapped="OnPrivacyTapped" /></Label.GestureRecognizers></Label>
                <Label Text="|" FontSize="12" TextColor="#374151" />
                <Label Text="Terms of Service" FontSize="12" TextColor="#6b7280"><Label.GestureRecognizers><TapGestureRecognizer Tapped="OnTermsTapped" /></Label.GestureRecognizers></Label>
                <Label Text="|" FontSize="12" TextColor="#374151" />
                <Label Text="Delete account" FontSize="12" TextColor="#6b7280"><Label.GestureRecognizers><TapGestureRecognizer Tapped="OnDeleteAccountTapped" /></Label.GestureRecognizers></Label>
            </HorizontalStackLayout>
            <Label x:Name="VersionLabel" FontSize="11" TextColor="#374151" HorizontalOptions="Center" Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
