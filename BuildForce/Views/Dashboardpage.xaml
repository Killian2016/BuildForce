<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BuildForce.Views.DashboardPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#080b10">

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,28" Spacing="14">

            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                <Border BackgroundColor="#2a2210" Stroke="Transparent"
                        StrokeShape="RoundRectangle 21"
                        WidthRequest="42" HeightRequest="42">
                    <Grid>
                        <Label x:Name="AvatarLabel" Text="--" FontSize="14" FontAttributes="Bold"
                               TextColor="#f0a500" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Image x:Name="AvatarImage" Aspect="AspectFill" IsVisible="False"
                               WidthRequest="42" HeightRequest="42" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAvatarTap" />
                    </Border.GestureRecognizers>
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label x:Name="UserNameLabel" Text="Loading..." FontSize="15"
                           FontAttributes="Bold" TextColor="#e6edf3" LineBreakMode="TailTruncation" />
                    <Label x:Name="RoleLabel" Text="" FontSize="11" TextColor="#7d8590" />
                </VerticalStackLayout>
                <Label x:Name="SyncLabel" Text="Syncing" FontSize="11" TextColor="#7d8590"
                       Grid.Column="2" VerticalOptions="Center" />
                <Grid Grid.Column="3" WidthRequest="42" HeightRequest="42">
                    <Border BackgroundColor="#161b22" Stroke="#1c2330" StrokeThickness="1"
                            StrokeShape="RoundRectangle 21" WidthRequest="42" HeightRequest="42">
                        <Label Text="&#x1F514;" FontSize="16"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Border x:Name="NotifBadge" IsVisible="False"
                            BackgroundColor="#8b5cf6" Stroke="Transparent"
                            StrokeShape="RoundRectangle 9" HeightRequest="18"
                            MinimumWidthRequest="18" Padding="5,0"
                            HorizontalOptions="End" VerticalOptions="Start"
                            TranslationX="3" TranslationY="-3">
                        <Label x:Name="NotifBadgeLabel" Text="0" FontSize="10"
                               FontAttributes="Bold" TextColor="#080b10"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNotifications" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Grid>

            <!-- [BFJOB1] office-only quick job - hidden unless AuthService.CanScheduleJobs -->
            <Border x:Name="NewJobCard" IsVisible="False" BackgroundColor="#0d1117" Stroke="#f0a500" StrokeThickness="1"
                    StrokeShape="RoundRectangle 14" Padding="16,16">
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="+" FontSize="22" FontAttributes="Bold" TextColor="#f0a500" VerticalOptions="Center" />
                    <Label Text="Schedule a New Job" FontSize="16" FontAttributes="Bold" TextColor="#f0a500" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnNewJob" /></Border.GestureRecognizers>
            </Border>

            <Label Text="FIELD TOOLS &#183; [D2]" FontSize="10" FontAttributes="Bold"
                   TextColor="#7d8590" CharacterSpacing="2" Margin="2,4,0,0" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                  ColumnSpacing="10" RowSpacing="10">

                <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#0d1117"
                        Stroke="#0ea5e9" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14" Padding="14,13">
                    <VerticalStackLayout Spacing="7">
                        <BoxView Color="#0ea5e9" HeightRequest="3" WidthRequest="26"
                                 CornerRadius="2" HorizontalOptions="Start" />
                        <Label Text="Project photos" FontSize="14" FontAttributes="Bold"
                               TextColor="#e6edf3" />
                        <Label Text="Capture site media" FontSize="11" TextColor="#7d8590" />
                        <Button Text="Take picture" BackgroundColor="#f0a500" TextColor="#080b10"
                                FontSize="11" FontAttributes="Bold" HeightRequest="34"
                                CornerRadius="9" Padding="0" Margin="0,4,0,0"
                                Clicked="OnTakePicture" />
                        <Button Text="View projects" BackgroundColor="Transparent" TextColor="#7d8590"
                                BorderColor="#1c2330" BorderWidth="1"
                                FontSize="11" HeightRequest="32" CornerRadius="9" Padding="0"
                                Clicked="OnViewProjects" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#0d1117"
                        Stroke="#1c2330" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14" Padding="14,13">
                    <VerticalStackLayout Spacing="7">
                        <BoxView Color="#10b981" HeightRequest="3" WidthRequest="26"
                                 CornerRadius="2" HorizontalOptions="Start" />
                        <Label Text="Daily site logs" FontSize="14" FontAttributes="Bold"
                               TextColor="#e6edf3" />
                        <Label Text="Weather, crew, work done" FontSize="11" TextColor="#7d8590" />
                        <Button Text="Start log" BackgroundColor="Transparent" TextColor="#10b981"
                                BorderColor="#10b981" BorderWidth="1"
                                FontSize="11" FontAttributes="Bold" HeightRequest="34"
                                CornerRadius="9" Padding="0" Margin="0,4,0,0"
                                Clicked="OnDailyLog" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDailyLogTap" />
                    </Border.GestureRecognizers>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#0d1117"
                        Stroke="#1c2330" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14" Padding="14,13">
                    <VerticalStackLayout Spacing="7">
                        <BoxView Color="#f0a500" HeightRequest="3" WidthRequest="26"
                                 CornerRadius="2" HorizontalOptions="Start" />
                        <Label Text="Crew" FontSize="14" FontAttributes="Bold" TextColor="#e6edf3" />
                        <Label x:Name="CrewSub" Text="Checking..." FontSize="11" TextColor="#7d8590" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCrew" />
                    </Border.GestureRecognizers>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#0d1117"
                        Stroke="#1c2330" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14" Padding="14,13">
                    <VerticalStackLayout Spacing="7">
                        <BoxView Color="#8b5cf6" HeightRequest="3" WidthRequest="26"
                                 CornerRadius="2" HorizontalOptions="Start" />
                        <Label Text="Blueprints" FontSize="14" FontAttributes="Bold"
                               TextColor="#e6edf3" />
                        <Label Text="Plans and sheets" FontSize="11" TextColor="#7d8590" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBlueprints" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>

            <Border BackgroundColor="#0d1117" Stroke="#1c2330" StrokeThickness="1"
                    StrokeShape="RoundRectangle 12" Padding="12,2">
                <Entry x:Name="SearchEntry" Placeholder="Search tools, logs, or photos"
                       PlaceholderColor="#7d8590" TextColor="#e6edf3"
                       BackgroundColor="Transparent" FontSize="13"
                       Completed="OnSearch" />
            </Border>

            <Label Text="DOCUMENTATION" FontSize="10" FontAttributes="Bold"
                   TextColor="#7d8590" CharacterSpacing="2" Margin="2,4,0,0" />

            <Border BackgroundColor="#0d1117" Stroke="#1c2330" StrokeThickness="1"
                    StrokeShape="RoundRectangle 14" Padding="0">
                <VerticalStackLayout Spacing="0">
                    <Grid Padding="14,12" ColumnDefinitions="4,*,Auto" ColumnSpacing="10">
                        <BoxView Color="#0ea5e9" WidthRequest="3" CornerRadius="2" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                            <Label Text="Materials received" FontSize="13" TextColor="#e6edf3" />
                            <Label x:Name="MaterialsSub" Text="Log a delivery or receipt" FontSize="11" TextColor="#7d8590" />
                        </VerticalStackLayout>
                        <Label Text="&#x203A;" FontSize="18" TextColor="#7d8590"
                               Grid.Column="2" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMaterialsReceived" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#1c2330" />
                    <Grid Padding="14,12" ColumnDefinitions="4,*,Auto" ColumnSpacing="10">
                        <BoxView Color="#10b981" WidthRequest="3" CornerRadius="2" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                            <Label Text="Safety inspection forms" FontSize="13" TextColor="#e6edf3" />
                            <Label Text="Daily and weekly checks" FontSize="11" TextColor="#7d8590" />
                        </VerticalStackLayout>
                        <Label Text="&#x203A;" FontSize="18" TextColor="#7d8590"
                               Grid.Column="2" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSafetyForms" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#1c2330" />
                    <Grid Padding="14,12" ColumnDefinitions="4,*,Auto" ColumnSpacing="10">
                        <BoxView Color="#f0a500" WidthRequest="3" CornerRadius="2" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                            <Label Text="Submittals" FontSize="13" TextColor="#e6edf3" />
                            <Label Text="Approvals and transmittals" FontSize="11" TextColor="#7d8590" />
                        </VerticalStackLayout>
                        <Label Text="&#x203A;" FontSize="18" TextColor="#7d8590"
                               Grid.Column="2" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSubmittals" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="ACCOUNT" FontSize="10" FontAttributes="Bold"
                   TextColor="#7d8590" CharacterSpacing="2" Margin="2,4,0,0" />

            <Border BackgroundColor="#0d1117" Stroke="#1c2330" StrokeThickness="1"
                    StrokeShape="RoundRectangle 14" Padding="0">
                <VerticalStackLayout Spacing="0">
                    <Grid Padding="14,12" ColumnDefinitions="*,Auto">
                        <Label Text="Account settings" FontSize="13" TextColor="#e6edf3"
                               VerticalOptions="Center" />
                        <Label Text="&#x203A;" FontSize="18" TextColor="#7d8590"
                               Grid.Column="1" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAccountSettings" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#1c2330" />
                    <Grid Padding="14,12" ColumnDefinitions="*,Auto">
                        <Label Text="Sign out" FontSize="13" TextColor="#ef4444"
                               VerticalOptions="Center" />
                        <Label x:Name="VersionLabel" Text="v2.5.1" FontSize="11"
                               TextColor="#7d8590" Grid.Column="1" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSignOut" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>